{
  "name": "career-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22 <27",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "start:worker": "node dist/server/worker.js",
    "collect": "tsx server/worker.ts",
    "video:studio": "remotion studio demo-video/index.ts",
    "video:render": "remotion render demo-video/index.ts CareerRadarDemo artifacts/demo/career-radar-demo.mp4 --codec=h264",
    "video:still": "remotion still demo-video/index.ts CareerRadarDemo artifacts/demo/career-radar-demo-thumbnail.png --frame=345",
    "presentation:studio": "remotion studio demo-video/index.ts --public-dir=artifacts/presentation/screenshots",
    "presentation:render": "remotion render demo-video/index.ts CareerRadarPresentation artifacts/presentation/career-radar-presentation-remotion-master.mp4 --codec=h264 --public-dir=artifacts/presentation/screenshots",
    "presentation:normalize": "ffmpeg -y -i artifacts/presentation/career-radar-presentation-remotion-master.mp4 -map 0:v:0 -c:v libx264 -preset medium -crf 19 -pix_fmt yuv420p -movflags +faststart -an artifacts/presentation/career-radar-presentation.mp4",
    "presentation:build": "pnpm presentation:subtitles && pnpm presentation:render && pnpm presentation:normalize && pnpm presentation:still",
    "presentation:still": "remotion still demo-video/index.ts CareerRadarPresentation artifacts/presentation/career-radar-presentation-thumbnail.png --frame=4245 --public-dir=artifacts/presentation/screenshots",
    "presentation:subtitles": "tsx demo-video/write-subtitles.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.13.0",
    "@hono/node-server": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "hono": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@remotion/cli": "^4.0.501",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "remotion": "^4.0.501",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
